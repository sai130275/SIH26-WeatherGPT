# -----------------------------------------------------------------------
# Group 3 — Environment Variable Template
# Copy to .env and fill in real values.  NEVER commit .env to git.
# -----------------------------------------------------------------------

# General
APP_NAME="WeatherGPT – AI & Weather Intelligence (Group 3)"
APP_VERSION="0.1.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# LLM (Phase 2+)
LLM_PROVIDER=openai          # openai | anthropic | google
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

# Condition Detection Thresholds (Phase 2)
# Override these to tune sensitivity for specific regions / use-cases.
HEAVY_RAIN_THRESHOLD_MM=50.0        # rainfall (mm) above which heavy rain triggers
HIGH_WIND_THRESHOLD_KMH=60.0        # wind speed (km/h) above which high wind triggers
EXTREME_HEAT_THRESHOLD_C=40.0       # temperature (°C) above which extreme heat triggers
LOW_VISIBILITY_THRESHOLD_KM=1.0     # visibility (km) below which low visibility triggers
